rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Unique usernames: one doc per lowercase name, owned by one uid
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
                    && name.matches('^[a-z0-9_.]{3,14}$');
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Shared billboard ads (any signed-in player can buy a slot)
    match /ads/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.t is string && request.resource.data.t.size() <= 40;
    }
    // Voice call signaling
    match /calls/{id} {
      allow read, write: if request.auth != null;
      match /{sub=**} { allow read, write: if request.auth != null; }
    }
  }
}
