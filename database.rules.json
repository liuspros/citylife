{
  "rules": {
    "players": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name','x','z','ry']) && newData.child('name').isString() && newData.child('name').val().length <= 14"
      }
    },
    "chat": {
      ".read": "auth != null",
      ".indexOn": ["t"],
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.child('uid').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 120"
      }
    }
  }
}
